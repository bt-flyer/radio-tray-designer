{
  "name": "radio-tray-designer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts --dev",
    "start": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "samples": "node --import tsx tests/generate-samples.ts",
    "build:pages": "tsc --noEmit && vite build --mode pages --base=/radio-tray-designer/ --outDir dist-pages && node scripts/package-pages.mjs",
    "preview:pages": "vite preview --base=/radio-tray-designer/ --outDir dist-pages --host 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "manifold-3d": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
